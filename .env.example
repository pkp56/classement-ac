# =============================================================================
# GDSP — configuration du serveur Node (gdsp.duckdns.org)
# =============================================================================
# Copier ce fichier en `.env` à la racine du dépôt, puis adapter les valeurs.
# `.env` est ignoré par Git : il ne doit jamais être versionné.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Unix)
#
# Après modification : redémarrer Node (service NSSM ou `npm start`).
# Les valeurs indiquées ici sont les valeurs par défaut du code quand il y en a.
# Les blocs marqués OBLIGATOIRE doivent être renseignés pour que la brique
# correspondante fonctionne ; sinon le site répond 503 avec une erreur explicite.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SOCLE — site et pages publiques
# -----------------------------------------------------------------------------
# Port d'écoute Node. Caddy proxifie https://gdsp.duckdns.org vers 127.0.0.1:10000.
PORT=10000
# URL publique exacte, sans slash final. Sert aux balises canonical, au sitemap
# et à l'en-tête injecté dans le script CSP de télémétrie.
PUBLIC_SITE_URL=https://gdsp.duckdns.org
# Proxy de confiance pour `req.secure` / `req.ip`. Caddy est sur la même machine.
TRUST_PROXY=loopback
# Backend historique : utilisé uniquement si EVENTS_SOURCE=backend.
BACKEND_URL=https://gdsp-render-backend.onrender.com

# -----------------------------------------------------------------------------
# 2. ÉVÉNEMENTS ET ADMINISTRATION — OBLIGATOIRE
# -----------------------------------------------------------------------------
# `local` (défaut) : événements et sauvegardes dans PostgreSQL.
# `backend` : ancien service distant (à éviter, un seul service suffit).
EVENTS_SOURCE=local
# Une seule des deux variables suffit. PostgreSQL / Neon.
EVENTS_DATABASE_URL=
# DATABASE_URL=
# Compte administrateur. Sans ADMIN_PASSWORD, le login refuse de signer un jeton :
# aucun identifiant de secours n'existe (volontaire, le dépôt est public).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secret de signature des jetons, 32+ caractères : `openssl rand -hex 32`.
# À défaut, il est dérivé de ADMIN_PASSWORD (moins propre).
JWT_SECRET=
# Exclusions de classement et sauvegardes locales (facultatif, valeurs par défaut) :
# GLOBAL_EXCLUSIONS_FILE=

# -----------------------------------------------------------------------------
# 3. LIVE TIMING — serveur AC local
# -----------------------------------------------------------------------------
LIVE_TIMING_ENABLED=1
# Jeton du mode push (agent sur un autre PC, ou l'agent local).
# Doit être identique à PUSH_TOKEN côté agent.
LIVE_PUSH_TOKEN=
# Liaison UDP du plugin ACSP tel que déclaré dans server_cfg.ini :
#   UDP_PLUGIN_ADDRESS=127.0.0.1:<AC_LISTEN_PORT>
#   UDP_PLUGIN_LOCAL_PORT=<AC_PLUGIN_PORT>
AC_HOST=127.0.0.1
AC_LISTEN_PORT=
AC_PLUGIN_PORT=
AC_SERVER_LABEL=GDSP 1
# Second serveur AC (optionnel) — mêmes règles.
AC_SECOND_LISTEN_PORT=
AC_SECOND_PLUGIN_PORT=
AC_SECOND_LABEL=GDSP 2
# Lecture HTTP d'un serveur public distant, liste séparée par des virgules.
# LIVE_HTTP_SOURCES=
# LIVE_HTTP_INTERVAL_MS=2000
# Historique live : PostgreSQL si renseigné, sinon fichier JSON local.
# LIVE_DATABASE_URL=
# LIVE_HISTORY_FILE=data/live-history.json
# Capture rejouée (outil `tools/live-timing/capture.js`).
# LIVE_MIRROR_FILE=data/live-mirror.json

# -----------------------------------------------------------------------------
# 4. TÉLÉMÉTRIE ET BOP
# -----------------------------------------------------------------------------
TELEMETRY_ENABLED=1
# Stockage : PostgreSQL si renseigné, sinon fichier JSON.
# TELEMETRY_DATABASE_URL=
# TELEMETRY_STORE_FILE=data/telemetry-store.json
# Le script CSP porte un jeton public : ce n'est PAS une authentification,
# seulement une limitation de débit. Laisser la valeur par défaut sauf besoin.
# TELEMETRY_RATE_LIMIT_PER_MINUTE=1200
# Autorise l'ingestion sans jeton (déconseillé hors essais locaux).
# TELEMETRY_ALLOW_OPEN=0

# -----------------------------------------------------------------------------
# 5. SCRIPTS CSP — rolling start, race control, propreté
# -----------------------------------------------------------------------------
# Aucune variable : les scripts sont servis publiquement depuis /csp/
#   /csp/rolling_start.lua   (rolling start + race control)
#   /csp/telemetry.lua       (télémétrie, en-tête personnalisé avec PUBLIC_SITE_URL)
#   /csp/cleanliness.lua     (détection de collisions)
# Sauvegarde avant nettoyage d'historique.
# GDSP_LIVE_CLEAN_BACKUP_DIR=

# -----------------------------------------------------------------------------
# 6. GESTION DES SERVEURS AC (Content Manager) — DÉSACTIVÉ PAR DÉFAUT
# -----------------------------------------------------------------------------
# Lecture seule : consulter les préréglages demande seulement GDSP_AC_SERVER_ROOT.
# Le reste est expérimental et NON validé sur Windows.
# GDSP_AC_SERVER_ROOT=C:\AssettoCorsa\server   <- chemin ABSOLU
# GDSP_AC_CONTENT_ROOT=C:\...\content
# GDSP_AC_EXTRA_CONTENT_ROOT=D:\...\content
# Dossier privé de sauvegarde : hors site, hors serveur, ACL NTFS restrictives.
# GDSP_AC_BACKUP_ROOT=
# Écriture des INI : laisser 0 tant que l'essai Windows n'est pas fait.
GDSP_CM_WRITES_ENABLED=0
# Démarrage/arrêt d'acServer : laisser 0 tant que l'essai Windows n'est pas fait.
GDSP_CM_CONTROL_ENABLED=0

# -----------------------------------------------------------------------------
# 7. IMPORT ASSETTOHOSTING
# -----------------------------------------------------------------------------
# Origines exactes autorisées (protocole + hôte + port). Ports par défaut :
AH_SERVERS=https://fr2.assettohosting.com:50648,https://fr5.assettohosting.com:50145

# -----------------------------------------------------------------------------
# 8. MISE À JOUR MOBILE (facultatif)
# -----------------------------------------------------------------------------
# GDSP_MOBILE_UPDATE_ENABLED=0
# GDSP_MOBILE_UPDATE_KEY_HASH=

# -----------------------------------------------------------------------------
# 9. PROTOTYPE AUTONOME (facultatif)
# -----------------------------------------------------------------------------
# GDSP_MANAGER_PORT=8780
